<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="400"
        android:fromAlpha="0"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:toAlpha="1" />
    <translate
        android:duration="400"
        android:fromYDelta="12%"
        android:interpolator="@android:interpolator/accelerate_decelerate"
        android:toYDelta="0" />
</set>
