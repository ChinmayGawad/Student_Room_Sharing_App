<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background">

    <!-- Top App Bar with Close Button -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_room"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Add New Room"
        app:navigationIcon="@drawable/baseline_close_24"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Material 3 Linear Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_add_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="25"
        app:indicatorColor="@color/md_theme_light_primary"
        app:trackColor="@color/md_theme_light_surface"
        app:trackCornerRadius="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_add_room" />

    <!-- ViewPager to hold the steps (Swiping will be disabled in Kotlin) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_add_room_steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progress_add_room"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_actions" />

    <!-- Persistent Bottom Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Back Button (Hidden on Step 1) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Back"
            android:textSize="16dp"
            android:textColor="@color/md_theme_light_onSurfaceVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Next / Publish Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_next"
            style="@style/Widget.Material3.Button"
            android:layout_width="140dp"
            android:layout_height="56dp"
            android:text="Next"
            android:textSize="16dp"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>