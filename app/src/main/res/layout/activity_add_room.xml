<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAddRoom"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/cd_close"
        app:navigationIcon="@drawable/baseline_close_24">

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Step 1/3" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:id="@+id/stepIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarAddRoom">

        <ImageView
            android:id="@+id/dotStep1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/circle_primary_filled"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/lineStep1"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:src="@drawable/line_outline"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/dotStep2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/circle_outline_hollow"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/lineStep2"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:src="@drawable/line_outline"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/dotStep3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/circle_outline_hollow"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpagerAddRoomSteps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elevation_raised"
        android:paddingHorizontal="@dimen/screen_margin_horizontal"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardBack"
            style="@style/Widget.StudentRoomSharing.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="Back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWizardNext"
            style="@style/Widget.StudentRoomSharing.Button.Filled"
            android:layout_width="140dp"
            android:layout_height="@dimen/button_height"
            android:text="@string/continue_text"
            app:cornerRadius="@dimen/corner_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
