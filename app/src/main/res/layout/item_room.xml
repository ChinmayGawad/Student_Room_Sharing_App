<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/md_theme_light_outline"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <!-- Room Image (Hero) -->
        <ImageView
            android:id="@+id/img_room_hero"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:src="@drawable/imageplaceholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Favorite / Save Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_save_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:fabSize="mini"
            app:tint="@color/md_theme_light_onSurfaceVariant"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            android:src="@drawable/baseline_favorite_border_24"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Room Price -->
        <TextView
            android:id="@+id/tv_room_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹8,500 / month"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_onBackground"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/img_room_hero"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Verified Owner Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/tv_room_price"
            app:layout_constraintBottom_toBottomOf="@id/tv_room_price"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/baseline_check_circle_24"
                app:tint="@color/md_theme_light_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verified Owner"
                android:textSize="12sp"
                android:textColor="@color/md_theme_light_primary"
                android:layout_marginStart="4dp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Room Title / Type -->
        <TextView
            android:id="@+id/tv_room_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Private Room in 3BHK"
            android:textSize="16sp"
            android:textColor="@color/md_theme_light_onSurface"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_room_price"
            app:layout_constraintStart_toStartOf="@id/tv_room_price"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Room Location -->
        <TextView
            android:id="@+id/tv_room_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kothrud, Pune • 1.2 km from campus"
            android:textSize="14sp"
            android:textColor="@color/md_theme_light_onSurfaceVariant"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_room_title"
            app:layout_constraintStart_toStartOf="@id/tv_room_title"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>