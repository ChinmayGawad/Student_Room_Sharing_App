<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/corner_large"
    app:cardElevation="@dimen/elevation_card"
    app:contentPadding="@dimen/elevation_none"
    app:strokeWidth="@dimen/elevation_none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Room Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/roomImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_room"
            app:layout_constraintDimensionRatio="4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeImageTopRounded"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Image Scrim (gradient overlay) -->
        <View
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="@drawable/scrim_top_down"
            app:layout_constraintEnd_toEndOf="@id/roomImage"
            app:layout_constraintStart_toStartOf="@id/roomImage"
            app:layout_constraintTop_toTopOf="@id/roomImage" />

        <!-- Status Badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_room_status"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_margin="@dimen/spacing_12"
            android:text="Available"
            android:textAppearance="@style/TextAppearance.LabelSmall"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="#10B981"
            app:chipCornerRadius="16dp"
            app:chipStrokeWidth="0dp"
            app:checkedIconVisible="false"
            app:closeIconVisible="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bookmark Button -->
        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="@dimen/spacing_8"
            android:background="@drawable/circle_background_white_30"
            android:contentDescription="@string/cd_bookmark"
            android:src="@drawable/baseline_favorite_border_24"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            app:layout_constraintTop_toBottomOf="@id/roomImage">

            <!-- Price -->
            <TextView
                android:id="@+id/roomPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.TitleMedium"
                android:textColor="@color/colorPrimary"
                android:text="$450/mo"
                tools:text="$450/mo" />

            <!-- Title -->
            <TextView
                android:id="@+id/roomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:text="Modern Studio Near Campus"
                tools:text="Modern Studio Near Campus" />

            <!-- Location Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_location_on_24"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:id="@+id/roomDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="2.3 km from University"
                    tools:text="2.3 km from University" />
            </LinearLayout>

            <!-- Rating Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_star_24"
                    app:tint="@color/colorWarning" />

                <TextView
                    android:id="@+id/roomRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:textAppearance="@style/TextAppearance.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="4.8 (24 reviews)"
                    tools:text="4.8 (24 reviews)" />
            </LinearLayout>

            <!-- Amenities Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_wifi_24"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:text="WiFi"
                    android:textAppearance="@style/TextAppearance.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_ac_unit_24"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:text="AC"
                    android:textAppearance="@style/TextAppearance.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_kitchen_24"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:text="Kitchen"
                    android:textAppearance="@style/TextAppearance.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
