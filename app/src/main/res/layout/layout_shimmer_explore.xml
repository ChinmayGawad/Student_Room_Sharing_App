<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:paddingTop="@dimen/spacing_12"
    android:visibility="gone">

    <include
        android:id="@+id/shimmer1"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginEnd="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

    <include
        android:id="@+id/shimmer2"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

    <include
        android:id="@+id/shimmer3"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

    <include
        android:id="@+id/shimmer4"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

    <include
        android:id="@+id/shimmer5"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginEnd="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

    <include
        android:id="@+id/shimmer6"
        layout="@layout/shimmer_room_skeleton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12" />

</GridLayout>
