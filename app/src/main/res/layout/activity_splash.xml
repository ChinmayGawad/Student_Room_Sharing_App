<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <!-- Logo -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toTopOf="@+id/splashTitle1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- App Title Line 1 -->
    <TextView
        android:id="@+id/splashTitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Student Room"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.HeadlineLarge"
        app:layout_constraintBottom_toTopOf="@+id/splashTitle2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashLogo" />

    <!-- App Title Line 2 -->
    <TextView
        android:id="@+id/splashTitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sharing"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.HeadlineLarge"
        app:layout_constraintBottom_toTopOf="@+id/splashTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashTitle1" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.8"
        android:text="@string/tagline"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.BodyLarge"
        app:layout_constraintBottom_toTopOf="@+id/splashProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashTitle2" />

    <!-- Linear Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/splashProgress"
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:indeterminate="true"
        app:indicatorColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@+id/splashVersion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashTagline"
        app:trackColor="#33FFFFFF" />

    <!-- Version Label -->
    <TextView
        android:id="@+id/splashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:alpha="0.6"
        android:text="v1.0.0"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.LabelMedium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/splashProgress" />

</androidx.constraintlayout.widget.ConstraintLayout>
