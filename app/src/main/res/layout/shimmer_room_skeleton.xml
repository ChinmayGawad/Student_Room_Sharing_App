<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/corner_large"
    app:cardElevation="@dimen/elevation_card"
    app:contentPadding="@dimen/elevation_none"
    app:strokeWidth="@dimen/elevation_none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/shimmerImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/shimmer_color"
            android:importantForAccessibility="no"
            app:layout_constraintDimensionRatio="4:3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <View
                android:id="@+id/shimmerPrice"
                android:layout_width="60dp"
                android:layout_height="14dp"
                android:background="@color/shimmer_color" />

            <View
                android:id="@+id/shimmerTitle"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@color/shimmer_color" />

            <View
                android:id="@+id/shimmerLocation"
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@color/shimmer_color" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
