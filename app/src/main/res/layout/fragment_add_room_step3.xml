<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_step3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pricing &amp; Amenities"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_step3_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set your monthly rent and highlight what makes your space great."
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_step3_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_monthly_rent"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Monthly Rent (₹)"
            app:layout_constraintTop_toBottomOf="@id/tv_step3_subtitle"
            app:startIconDrawable="@drawable/baseline_payments_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_monthly_rent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_security_deposit"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Security Deposit (₹)"
            app:helperText="Usually 1-2 months rent"
            app:layout_constraintTop_toBottomOf="@id/til_monthly_rent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_security_deposit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_amenities_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Included Amenities"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_security_deposit" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_amenities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_amenities_title"
            app:singleSelection="false"> <com.google.android.material.chip.Chip
            android:id="@+id/chip_wifi"
            style="@style/Widget.StudentRoomSharing.Chip.Amenity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High-Speed WiFi" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ac"
                style="@style/Widget.StudentRoomSharing.Chip.Amenity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Air Conditioning" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_attached_bath"
                style="@style/Widget.StudentRoomSharing.Chip.Amenity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attached Bath" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_furnished"
                style="@style/Widget.StudentRoomSharing.Chip.Amenity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fully Furnished" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_washing_machine"
                style="@style/Widget.StudentRoomSharing.Chip.Amenity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Washing Machine" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_balcony"
                style="@style/Widget.StudentRoomSharing.Chip.Amenity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balcony" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_utilities_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="* Note: Ensure your description (in Step 1) clarifies if electricity or water bills are excluded from the monthly rent."
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_group_amenities" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>