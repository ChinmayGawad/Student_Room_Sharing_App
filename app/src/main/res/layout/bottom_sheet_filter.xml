<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:paddingTop="@dimen/spacing_8"
    android:paddingBottom="@dimen/spacing_24"
>

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="@drawable/bottom_sheet_handle"
        android:importantForAccessibility="no" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filters"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseFilter"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/button_min_width"
            android:layout_height="@dimen/button_min_width"
            android:contentDescription="@string/cd_close"
            app:icon="@drawable/baseline_close_24"
            app:iconSize="@dimen/icon_size_large"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/spacing_12"
        android:background="?attr/colorOutlineVariant" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Section 1: Price Range ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_range"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/priceRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:valueFrom="200"
                android:valueTo="1500"
                app:labelBehavior="floating" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPriceMin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="$200"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvPriceMax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="$1,500"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- ===== Section 2: Gender Preference ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_preference"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGenderAny"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:checked="true"
                    android:text="@string/filter_all"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGenderMale"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/male"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGenderFemale"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/female"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- ===== Section 3: Room Type ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_type"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRoomType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeStudio"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/studio"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType1BHK"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/bhk_1"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType2BHK"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/bhk_2"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType3BHK"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/bhk_3"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypePG"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/categories_pg"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeHostel"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="@string/hostel"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- ===== Section 4: Amenities ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amenities"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:columnCount="4"
                android:rowCount="2">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityWiFi"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_wifi"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_wifi_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityAC"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_ac"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_ac_unit_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityKitchen"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_kitchen"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_kitchen_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityLaundry"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_laundry"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_local_laundry_service_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityParking"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_parking"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_local_parking_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityGym"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_gym"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_fitness_center_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityPool"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/pool"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_pool_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenitySecurity"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="@dimen/amenity_chip_size"
                    android:layout_height="@dimen/amenity_chip_size"
                    android:gravity="center"
                    android:text="@string/amenity_security"
                    android:textAlignment="center"
                    app:chipBackgroundColor="@drawable/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipIcon="@drawable/baseline_security_24"
                    app:chipIconTint="@color/chip_text_selector"
                    app:iconSize="@dimen/icon_size_medium" />
            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- ===== Section 5: Distance from Campus ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/distance_from_campus"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.slider.Slider
                android:id="@+id/distanceSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:value="5"
                android:valueFrom="0"
                android:valueTo="10"
                app:labelBehavior="floating" />

            <TextView
                android:id="@+id/tvDistanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/within_km"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- ===== Section 6: Availability ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/availability"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkAvailableNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_4"
                    android:text="@string/available_now"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkMoveInReady"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_4"
                    android:text="@string/move_in_ready"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkFurnished"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/furnished"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="@string/reset"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="@dimen/corner_medium"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="@string/apply_filters"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="@dimen/corner_medium" />
    </LinearLayout>
</LinearLayout>
