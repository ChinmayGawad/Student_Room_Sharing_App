<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_margin_horizontal"
    android:paddingTop="@dimen/spacing_8"
    android:paddingBottom="@dimen/spacing_24">

    <!-- Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="@drawable/bottom_sheet_handle"
        android:importantForAccessibility="no" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filters"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseFilter"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/button_min_width"
            android:layout_height="@dimen/button_min_width"
            android:contentDescription="@string/cd_close"
            app:icon="@drawable/baseline_close_24"
            app:iconSize="@dimen/icon_size_large"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/spacing_12"
        android:background="?attr/colorOutlineVariant" />

    <!-- Scrollable Filter Options -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Monthly Rent Range -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Rent (₹)"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/priceRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:valueFrom="2000"
                android:valueTo="30000"
                android:stepSize="1000"
                app:labelBehavior="floating" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPriceMin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹2,000"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvPriceMax"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="₹30,000"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- Section 2: Room Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Type"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRoomType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeAny"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:checked="true"
                    android:text="Any"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypePrivate"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Private Room"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeShared"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Shared Room"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypePG"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="PG"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeFlat"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Flat"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- Section 3: Amenities Required -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required Amenities"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityWifi"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="High-Speed WiFi"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityAC"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Air Conditioning"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityBath"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Attached Bath"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityFurnished"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Fully Furnished"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityLaundry"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Washing Machine"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAmenityBalcony"
                    style="@style/Widget.StudentRoomSharing.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:text="Balcony"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector" />
            </com.google.android.material.chip.ChipGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_16"
                android:background="?attr/colorOutlineVariant" />

            <!-- Section 4: Availability -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkOnlyAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hide booked rooms (Only Available)"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="@string/reset"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="@dimen/corner_medium"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            style="@style/Widget.StudentRoomSharing.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="@string/apply_filters"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="@dimen/corner_medium" />
    </LinearLayout>

</LinearLayout>
