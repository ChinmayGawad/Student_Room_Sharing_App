<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_step2_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show off your space"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_light_onBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_step2_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Students book rooms with great photos. Add at least 3 photos of the bedroom, bathroom, and amenities."
        android:textColor="@color/md_theme_light_onSurfaceVariant"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_step2_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Massive Tap-to-Upload Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_upload_photos"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_light_outline"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_step2_subtitle">

        <!-- Using a dashed outline effect visually indicates "Drop Zone" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#F5F7FA">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/baseline_add_a_photo_24"
                app:tint="@color/md_theme_light_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to add photos from gallery"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_primary"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Placeholder for a RecyclerView that will show a grid of the selected photos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_selected_photos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/card_upload_photos"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>