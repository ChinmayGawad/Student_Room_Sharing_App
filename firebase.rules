{
  "rules": {
    "Rooms": {
      ".read": true,
      ".indexOn": ["userId", "price"],
      "$roomId": {
        ".write": "auth != null && (data.child('userId').val() === auth.uid || !data.exists())",
        ".validate": "newData.hasChildren(['roomName', 'price', 'userId'])"
      }
    },
    "Users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "$userId === auth.uid",
        "favorites": {
          "$favoriteId": {
            ".read": "$userId === auth.uid",
            ".write": "$userId === auth.uid"
          }
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['message', 'senderId', 'timestamp']) && newData.child('senderId').val() === auth.uid"
          }
        }
      }
    },
    "inbox": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "auth != null"
      }
    }
  }
}
